---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noHero?: boolean;   // if true, header gets dark logo from start
  schemaOrg?: object;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description,
  image = '/images/stephan-portrait.jpg',
  schemaOrg,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const SITE = 'https://stephanschmied.com';

// Grundgerüst für Suchmaschinen und KI-Assistenten: auf JEDER Seite gleich.
// Seiten verweisen über die @id darauf (z. B. Blogartikel → author).
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Stephan Schmied – Hair & Make-up Artist Berlin',
      inLanguage: 'de-DE',
      publisher: { '@id': `${SITE}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#person`,
      name: 'Stephan Schmied',
      jobTitle: 'Hair & Make-up Artist',
      description:
        'Hair & Make-up Artist in Berlin, freiberuflich seit 1987. Ausbildung als Friseur in Wien, seit 1998 in Berlin. Arbeiten für Vogue, Elle, Vanity Fair, GQ, Gala und die Fashion Shows von Victoria\'s Secret. Markenbotschafter für Max Factor in Deutschland, Österreich und der Schweiz von 2007 bis 2019. Heute Make-up Coaching, Braut-Make-up, Editorial und Events.',
      url: `${SITE}/about`,
      image: `${SITE}/images/stephan-portrait.jpg`,
      telephone: '+491773238988',
      email: 'stephan@stephanschmied.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
      homeLocation: { '@type': 'City', name: 'Berlin' },
      sameAs: ['https://instagram.com/schmiedsteph'],
      knowsAbout: [
        'Make-up Coaching',
        'Braut-Make-up',
        'Hochzeits-Hairstyling',
        'Editorial Make-up',
        'Hair Styling',
        'Grooming für Männer',
        'Drogerie-Make-up',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Hair & Make-up Artist',
        occupationLocation: { '@type': 'City', name: 'Berlin' },
      },
      worksFor: { '@id': `${SITE}/#business` },
    },
    {
      '@type': ['LocalBusiness', 'ProfessionalService'],
      '@id': `${SITE}/#business`,
      name: 'Stephan Schmied – Hair & Make-up Artist',
      description:
        'Mobiler Hair & Make-up Artist in Berlin: Make-up Coaching (Einzel, Workshop, Firmen), Braut-Make-up und Hochzeits-Styling, Editorial, Events und Grooming. Berlin, Brandenburg und deutschlandweit.',
      url: SITE,
      telephone: '+491773238988',
      email: 'stephan@stephanschmied.com',
      image: `${SITE}/images/stephan-portrait.jpg`,
      logo: `${SITE}/favicon.svg`,
      address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
      areaServed: [
        { '@type': 'City', name: 'Berlin' },
        { '@type': 'State', name: 'Brandenburg' },
        { '@type': 'Country', name: 'Deutschland' },
      ],
      priceRange: '€€€',
      currenciesAccepted: 'EUR',
      founder: { '@id': `${SITE}/#person` },
      sameAs: ['https://instagram.com/schmiedsteph'],
    },
  ],
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://stephanschmied.com');
const ogImage = new URL(image, Astro.site ?? 'https://stephanschmied.com');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Stephan Schmied" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="geo.region" content="DE-BE" />
    <meta name="geo.placename" content="Berlin" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="Stephan Schmied" />}
    <meta property="og:site_name"   content="Stephan Schmied – Hair & Make-up Artist Berlin" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content="de_DE" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schema.org: Grundgerüst (jede Seite) + seitenspezifisch -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {schemaOrg && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    )}

    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- WhatsApp Float -->
    <a
      href="https://wa.me/491773238988"
      class="whatsapp-float"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp Kontakt"
    >
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
      </svg>
    </a>

    <!-- Fade-in Observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
