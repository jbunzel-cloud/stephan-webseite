---
import Layout from '../layouts/Layout.astro';

const formats = [
  {
    id: 'einzelcoaching',
    title: '1:1 Coaching',
    text: 'Nur du und ich. 2 Stunden ungestörter Fokus auf dein Gesicht, deine Produkte und deinen persönlichen Look. Wir analysieren deine Gesichtsform, finden die Produkte die zu dir passen und ich zeige dir Schritt für Schritt, wie du das Beste aus dir herausholst. Ort nach Absprache.',
    price: 'Ab 249 EUR',
  },
  {
    id: 'gruppenworkshop',
    title: 'Gruppen-Workshop',
    text: 'Ab 3 Stunden mit maximal 6 Teilnehmerinnen. Themenfokus: Alltags-Make-up, Abend-Look oder Hochzeit. Praxis, kein Vortrag.',
    price: 'Ab 149 EUR pro Person',
  },
  {
    id: 'teamevent',
    title: 'Team-Event',
    text: 'Make-up Coaching als Firmenevent. Self-Care Day, Team-Building, Kundinnen-Event. Ich komme zu euch.',
    price: 'Ab 1.500 EUR',
  },
];
---

<Layout
  title="Make-up Coaching – Stephan Schmied Hair & Make-up Artist Berlin"
  description="Hör auf, Geld für Make-up auszugeben, das nicht zu dir passt. Stephan Schmied zeigt dir in einem persönlichen Coaching, was wirklich zu dir gehört – 1:1, Gruppe oder Team-Event in Berlin."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="label">Coaching &amp; Kurse</span>
      <h1>Make-up Coaching</h1>
      <p>Dein Make-up soll zu dir passen – nicht umgekehrt.</p>
    </div>
  </section>

  <!-- ─── Hook ─── -->
  <section class="coaching-hook">
    <div class="container">
      <div class="hook-inner fade-in">
        <p class="hook-stat">1.000 €</p>
        <p class="hook-text">So viel geben viele Frauen für Make-up aus, das nicht zu ihnen passt – und das ungenutzt in der Schublade landet. Nicht weil sie falsch schmücken. Sondern weil niemand ihnen je erklärt hat, was wirklich zu ihrem Gesicht, ihrer Haut und ihrem Alltag gehört.</p>
        <p class="hook-cta">Genau das ändere ich.</p>
      </div>
    </div>
  </section>

  <!-- ─── Intro ─── -->
  <section class="section coaching-intro">
    <div class="container">
      <div class="coaching-intro-grid fade-in">
        <div class="coaching-intro-img">
          <img
            src="/images/coaching/coaching-02-altbau.jpg"
            alt="Stephan Schmied im Studio – Make-up Coaching"
            width="600" height="750"
            loading="lazy"
            style="width:100%;object-fit:cover;display:block"
          />
        </div>
        <div class="coaching-intro-inner">
          <p>Ich habe fast 40 Jahre lang die Gesichter geschminkt, die du aus Magazinen kennst – Kate Moss, Iris Berben, Gwyneth Paltrow, Toni Garn. Was ich dabei gelernt habe: Jedes Gesicht ist anders. Und jede Frau verdient einen Look, der ihr gehört.</p>
          <p class="mt-sm">Meine Coachings sind kein Kurs und kein Tutorial. Du bringst deine eigenen Produkte mit – ich zeige dir, was davon wirklich zu dir passt, was du weglassen kannst und wie du in zehn Minuten das Beste aus dir herausholst.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Formate ─── -->
  <section class="section" style="background:#fff">
    <div class="container">
      <div class="fade-in text-center">
        <span class="label">Was ich anbiete</span>
        <h2 class="section-title">Formate</h2>
      </div>
      <div class="formats-grid mt-md">
        {formats.map((f, i) => (
          <div class:list={['format-card fade-in', `delay-${i}`]}>
            <h3>{f.title}</h3>
            <p class="format-text">{f.text}</p>
            <div class="format-price">{f.price}</div>
            <a href="/contact?anlass=Coaching" class="btn btn-outline mt-sm">Anfragen</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Testimonials ─── -->
  <section class="section">
    <div class="container">
      <div class="fade-in text-center">
        <span class="label">Was Teilnehmer sagen</span>
        <h2 class="section-title">Stimmen</h2>
      </div>
      <div class="testimonials-grid mt-md" style="max-width:800px;margin-left:auto;margin-right:auto;margin-top:var(--sp-md)">
        <div class="testimonial fade-in">
          <blockquote>"Das Coaching war absolut beeindruckend. Stephan teilt sein Wissen großzügig und erklärt jeden Schritt verständlich. Ich habe mehr gelernt als in jedem Kurs."</blockquote>
          <cite>— Sabine M., Make-up Enthusiastin, Hamburg</cite>
        </div>
        <div class="testimonial fade-in delay-1">
          <blockquote>"Als Berufseinsteigerin war das 1:1 Coaching ein Wendepunkt für mich. Die Technik, die Atmosphäre, das direkte Feedback – unbezahlbar."</blockquote>
          <cite>— Lena K., Auszubildende Make-up Artistin, Berlin</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Aus dem Studio ─── -->
  <section class="section studio-section" style="background:#fff">
    <div class="container">
      <div class="fade-in text-center">
        <span class="label">Einblicke</span>
        <h2 class="section-title">Eindrücke aus dem Coaching</h2>
      </div>
      <div class="studio-grid mt-md">
        <div class="studio-item fade-in">
          <img src="/images/coaching/coaching-02-altbau.jpg" alt="Make-up Coaching Berlin – Stephan Schmied" width="400" height="500" loading="lazy" />
        </div>
        <div class="studio-item fade-in delay-1">
          <img src="/images/coaching/coaching-04-gesicht.jpg" alt="Make-up Coaching – Gesichtsanalyse" width="400" height="500" loading="lazy" />
        </div>
        <div class="studio-item fade-in delay-2">
          <img src="/images/coaching/coaching-05-lippenstift.jpg" alt="Make-up Coaching – Kundin übt unter Anleitung" width="400" height="500" loading="lazy" />
        </div>
        <div class="studio-item fade-in delay-3">
          <img src="/images/coaching/coaching-07-selbst-schminken.jpg" alt="Make-up Coaching – Kundin übt Augen-Make-up selbst" width="400" height="500" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section class="cta-section fade-in">
    <h2>Bereit für dein Coaching?</h2>
    <a href="/contact?anlass=Coaching" class="btn btn-gold">Jetzt anfragen</a>
  </section>
</Layout>

<style>
  /* ─── Hook ─── */
  .coaching-hook {
    background: var(--color-dark);
    padding: var(--sp-lg) var(--sp-md);
    text-align: center;
  }
  .hook-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .hook-stat {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 7vw, 5rem);
    color: var(--color-gold);
    line-height: 1;
    margin-bottom: 1.25rem;
    max-width: none;
  }
  .hook-text {
    color: rgba(255,255,255,0.75);
    font-size: 1rem;
    line-height: 1.8;
    max-width: none;
    margin-bottom: 1.5rem;
  }
  .hook-cta {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-style: italic;
    color: #fff;
    max-width: none;
  }

  .formats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .format-card {
    border: 1px solid var(--color-border);
    padding: 2.5rem var(--sp-md);
    transition: box-shadow var(--transition);
    display: flex;
    flex-direction: column;
  }
  .format-card:hover { box-shadow: 0 8px 40px rgba(0,0,0,0.08); }
  .format-card h3 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .format-text {
    font-size: 0.92rem;
    color: var(--color-secondary);
    line-height: 1.75;
    flex: 1;
    max-width: none;
  }
  .format-price {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-text);
    margin-top: 1.25rem;
  }

  .coaching-intro { background: #fff; }
  .coaching-intro-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-lg);
    align-items: center;
  }
  .coaching-intro-img {
    max-width: 480px;
    margin: 40px 40px 40px 0;
  }
  .coaching-intro-img img {
    max-height: 500px;
    object-fit: cover;
    display: block;
  }
  .coaching-intro-inner {
    max-width: 600px;
  }
  .coaching-intro-inner p {
    font-size: 1.05rem;
    color: var(--color-secondary);
    line-height: 1.8;
    max-width: none;
  }

  /* ─── Aus dem Studio ─── */
  .studio-section { background: #fff; }
  .studio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }
  .studio-item img {
    width: 100%;
    max-width: 380px;
    max-height: 420px;
    object-fit: cover;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .coaching-intro-img { max-width: 320px; margin: 20px auto; }
    .formats-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .coaching-intro-grid { grid-template-columns: 1fr; }
    .coaching-intro-img { max-width: 100%; margin: 0; }
    .coaching-intro-img img { max-height: 400px; width: 100%; }
    .studio-grid { grid-template-columns: 1fr; }
  }
</style>
