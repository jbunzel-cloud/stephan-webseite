---
import Layout from '../layouts/Layout.astro';

const formats = [
  {
    id: 'einzelcoaching',
    title: 'Private Session',
    text: 'Nur du und ich. 2 Stunden ungestörter Fokus auf dein Gesicht, deine Produkte und deinen persönlichen Look. Du bringst mit, was du hast – ich zeige dir, was davon wirklich zu dir passt, was du weglassen kannst und wie du in Zukunft gezielter einkaufst. Ort nach Absprache.',
    price: 'Ab 450 EUR',
  },
  {
    id: 'gruppenworkshop',
    title: 'Workshop',
    text: 'Ab 3 Stunden mit maximal 6 Teilnehmerinnen. Themenfokus: Alltags-Make-up, Abend-Look oder Hochzeit. Praxis, kein Vortrag.',
    price: 'Ab 220 EUR pro Person',
  },
  {
    id: 'teamevent',
    title: 'Corporate',
    text: 'Make-up Coaching als Firmenevent. Self-Care Day, Team-Building, Kundinnen-Event. Ich komme zu euch – Ort, Umfang und Programm nach Absprache.',
    price: 'Auf Anfrage',
  },
];

// Fragen & Antworten: sichtbar auf der Seite UND als strukturierte Daten.
// KI-Assistenten zitieren solche klaren Frage-Antwort-Paare besonders gern.
const faqs = [
  {
    q: 'Was kostet ein Make-up Coaching bei Stephan Schmied in Berlin?',
    a: 'Die Private Session (2 Stunden, nur du und Stephan) kostet ab 450 EUR. Der Workshop in der Kleingruppe (ab 3 Stunden, maximal 6 Teilnehmerinnen) kostet ab 220 EUR pro Person. Coachings für Firmen und Teams gibt es auf Anfrage.',
  },
  {
    q: 'Muss ich mein eigenes Make-up mitbringen?',
    a: 'Ja, bitte. Du bringst mit, was du hast. Stephan zeigt dir, was davon wirklich zu deinem Gesicht, deiner Haut und deinem Alltag passt, was du weglassen kannst und wie du künftig gezielter einkaufst.',
  },
  {
    q: 'Brauche ich teure High-End-Produkte?',
    a: 'Nein. Stephan arbeitet im Coaching bewusst auch mit Produkten, die du zu Hause hast oder in der Drogerie wie DM findest. Entscheidend ist nicht der Preis, sondern dass Farbe, Textur und Technik zu dir passen.',
  },
  {
    q: 'Für wen ist das Make-up Coaching geeignet?',
    a: 'Für jede, die zu viel Make-up kauft, das am Ende ungenutzt in der Schublade liegt, oder sich mit ihrem Look unsicher fühlt. Vorkenntnisse brauchst du nicht. Auch angehende Make-up Artists nutzen die Private Session für direktes Feedback.',
  },
  {
    q: 'Kann ich ein Make-up Coaching verschenken?',
    a: 'Ja. Es gibt Gutscheine für die Private Session und für den Workshop, auf Wunsch mit persönlicher Widmung. Anfrage am einfachsten per WhatsApp unter +49 177 323 8988.',
  },
  {
    q: 'Wo findet das Coaching statt?',
    a: 'In Berlin, der Ort wird individuell abgesprochen. Für Firmen-Coachings und Team-Events kommt Stephan zu euch ins Unternehmen.',
  },
  {
    q: 'Wer ist Stephan Schmied?',
    a: 'Stephan Schmied ist Hair & Make-up Artist in Berlin und seit 1987 selbstständig. Er hat für Vogue, Elle, Vanity Fair und GQ gearbeitet, für die Fashion Shows von Victoria\'s Secret und war von 2007 bis 2019 Markenbotschafter für Max Factor in Deutschland, Österreich und der Schweiz.',
  },
  {
    q: 'Wie buche ich ein Coaching?',
    a: 'Am schnellsten per WhatsApp unter +49 177 323 8988, alternativ per Telefon oder E-Mail an stephan@stephanschmied.com. Stephan antwortet in der Regel innerhalb von 24 Stunden.',
  },
];

const SITE = 'https://stephanschmied.com';
const coachingSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${SITE}/masterclasses#coaching`,
      name: 'Make-up Coaching in Berlin',
      serviceType: 'Make-up Coaching',
      description:
        'Persönliches Make-up Coaching mit Stephan Schmied: Einzelsession, Workshop in der Kleingruppe oder Firmen-Event. Mit den eigenen Produkten, auch Drogerie.',
      provider: { '@id': `${SITE}/#business` },
      areaServed: { '@type': 'City', name: 'Berlin' },
      offers: [
        { '@type': 'Offer', name: 'Private Session (2 Stunden)', priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', minPrice: 450, priceCurrency: 'EUR' } },
        { '@type': 'Offer', name: 'Workshop (ab 3 Stunden, max. 6 Personen)', priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', minPrice: 220, priceCurrency: 'EUR', unitText: 'pro Person' } },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Make-up Coaching – Stephan Schmied Hair & Make-up Artist Berlin"
  description="Hör auf, Geld für Make-up auszugeben, das nicht zu dir passt. Stephan Schmied zeigt dir in einem persönlichen Coaching, was wirklich zu dir gehört – 1:1, Gruppe oder Team-Event in Berlin."
  schemaOrg={coachingSchema}
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="label">Coaching &amp; Kurse</span>
      <h1>Make-up Coaching</h1>
      <p>Dein Make-up soll zu dir passen – nicht umgekehrt.</p>
    </div>
  </section>

  <!-- ─── Hook ─── -->
  <section class="coaching-hook">
    <div class="container">
      <div class="hook-inner fade-in">
        <p class="hook-stat">1.000 €</p>
        <p class="hook-text">So viel geben viele Frauen für Make-up aus, das nicht zu ihnen passt – und das ungenutzt in der Schublade landet. Nicht weil sie falsch schmücken. Sondern weil niemand ihnen je erklärt hat, was wirklich zu ihrem Gesicht, ihrer Haut und ihrem Alltag gehört.</p>
        <p class="hook-cta">Genau das ändere ich.</p>
      </div>
    </div>
  </section>

  <!-- ─── Intro ─── -->
  <section class="section coaching-intro">
    <div class="container">
      <div class="coaching-intro-grid fade-in">
        <div class="coaching-intro-img">
          <img
            src="/images/coaching/coaching-02-altbau.jpg"
            alt="Stephan Schmied im Studio – Make-up Coaching"
            width="600" height="750"
            loading="lazy"
            style="width:100%;object-fit:cover;display:block"
          />
        </div>
        <div class="coaching-intro-inner">
          <p>Ich habe fast 40 Jahre lang die Gesichter geschminkt, die du aus Magazinen kennst – Kate Moss, Iris Berben, Gwyneth Paltrow, Toni Garn. Was ich dabei gelernt habe: Jedes Gesicht ist anders. Und jede Frau verdient einen Look, der ihr gehört.</p>
          <p class="mt-sm">Meine Coachings sind kein Kurs und kein Tutorial. Du bringst deine eigenen Produkte mit – ich zeige dir, was davon wirklich zu dir passt, was du weglassen kannst und wie du in zehn Minuten das Beste aus dir herausholst.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Formate ─── -->
  <section class="section" style="background:#fff">
    <div class="container">
      <div class="fade-in text-center">
        <span class="label">Was ich anbiete</span>
        <h2 class="section-title">Formate</h2>
      </div>
      <div class="formats-grid mt-md">
        {formats.map((f, i) => (
          <div class:list={['format-card fade-in', `delay-${i}`]}>
            <h3>{f.title}</h3>
            <p class="format-text">{f.text}</p>
            <div class="format-price">{f.price}</div>
            <a href="/contact?anlass=Coaching" class="btn btn-outline mt-sm">Anfragen</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Testimonials ─── -->
  <section class="section">
    <div class="container">
      <div class="fade-in text-center">
        <span class="label">Was Teilnehmer sagen</span>
        <h2 class="section-title">Stimmen</h2>
      </div>
      <div class="testimonials-grid mt-md" style="max-width:800px;margin-left:auto;margin-right:auto;margin-top:var(--sp-md)">
        <div class="testimonial fade-in">
          <blockquote>"Das Coaching war absolut beeindruckend. Stephan teilt sein Wissen großzügig und erklärt jeden Schritt verständlich. Ich habe mehr gelernt als in jedem Kurs."</blockquote>
          <cite>— Sabine M., Make-up Enthusiastin, Hamburg</cite>
        </div>
        <div class="testimonial fade-in delay-1">
          <blockquote>"Als Berufseinsteigerin war das 1:1 Coaching ein Wendepunkt für mich. Die Technik, die Atmosphäre, das direkte Feedback – unbezahlbar."</blockquote>
          <cite>— Lena K., Auszubildende Make-up Artistin, Berlin</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Aus dem Studio ─── -->
  <section class="section studio-section" style="background:#fff">
    <div class="container">
      <div class="fade-in text-center">
        <span class="label">Einblicke</span>
        <h2 class="section-title">Eindrücke aus dem Coaching</h2>
      </div>
      <div class="studio-grid mt-md">
        <div class="studio-item fade-in">
          <img src="/images/coaching/coaching-02-altbau.jpg" alt="Make-up Coaching Berlin – Stephan Schmied" width="400" height="500" loading="lazy" />
        </div>
        <div class="studio-item fade-in delay-1">
          <img src="/images/coaching/coaching-04-gesicht.jpg" alt="Make-up Coaching – Gesichtsanalyse" width="400" height="500" loading="lazy" />
        </div>
        <div class="studio-item fade-in delay-2">
          <img src="/images/coaching/coaching-05-lippenstift.jpg" alt="Make-up Coaching – Kundin übt unter Anleitung" width="400" height="500" loading="lazy" />
        </div>
        <div class="studio-item fade-in delay-3">
          <img src="/images/coaching/coaching-07-selbst-schminken.jpg" alt="Make-up Coaching – Kundin übt Augen-Make-up selbst" width="400" height="500" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Gutschein ─── -->
  <section class="coaching-hook gift-section" id="gutschein">
    <div class="hook-inner fade-in">
      <span class="label">Zum Verschenken</span>
      <h2 class="gift-title">Ein Coaching als Geschenk</h2>
      <p class="hook-text">Für die Frau, die alles hat, außer einem Make-up, das wirklich zu ihr passt. Gutscheine gibt es für die Private Session (ab 450 EUR) und den Workshop (ab 220 EUR pro Person), auf Wunsch mit persönlicher Widmung von Stephan.</p>
      <a href="https://wa.me/491773238988?text=Hallo%20Stephan%2C%20ich%20m%C3%B6chte%20gern%20einen%20Gutschein%20f%C3%BCr%20ein%20Make-up%20Coaching%20verschenken." target="_blank" rel="noopener noreferrer" class="btn btn-gold">Gutschein anfragen</a>
    </div>
  </section>

  <!-- ─── FAQ ─── -->
  <section class="section" id="faq">
    <div class="container">
      <div class="fade-in text-center">
        <span class="label">Häufige Fragen</span>
        <h2 class="section-title">FAQ</h2>
      </div>
      <div class="faq-list mt-md" style="max-width:750px;margin-top:var(--sp-md)">
        {faqs.map(f => (
          <details class="faq-item fade-in">
            <summary>{f.q}</summary>
            <p class="faq-body">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section class="cta-section fade-in">
    <h2>Bereit für dein Coaching?</h2>
    <a href="/contact?anlass=Coaching" class="btn btn-gold">Jetzt anfragen</a>
  </section>
</Layout>

<style>
  /* ─── Hook ─── */
  .coaching-hook {
    background: var(--color-dark);
    padding: var(--sp-lg) var(--sp-md);
    text-align: center;
  }
  .hook-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .hook-stat {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 7vw, 5rem);
    color: var(--color-gold);
    line-height: 1;
    margin-bottom: 1.25rem;
    max-width: none;
  }
  .hook-text {
    color: rgba(255,255,255,0.75);
    font-size: 1rem;
    line-height: 1.8;
    max-width: none;
    margin-bottom: 1.5rem;
  }
  .hook-cta {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-style: italic;
    color: #fff;
    max-width: none;
  }

  .gift-title {
    font-family: var(--font-heading);
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 400;
    margin: 0.5rem 0 1.25rem;
  }
  .gift-section .label { color: var(--color-gold); }
  .formats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .format-card {
    border: 1px solid var(--color-border);
    padding: 2.5rem var(--sp-md);
    transition: box-shadow var(--transition);
    display: flex;
    flex-direction: column;
  }
  .format-card:hover { box-shadow: 0 8px 40px rgba(0,0,0,0.08); }
  .format-card h3 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .format-text {
    font-size: 0.92rem;
    color: var(--color-secondary);
    line-height: 1.75;
    flex: 1;
    max-width: none;
  }
  .format-price {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-text);
    margin-top: 1.25rem;
  }

  .coaching-intro { background: #fff; }
  .coaching-intro-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-lg);
    align-items: center;
  }
  .coaching-intro-img {
    max-width: 480px;
    margin: 40px 40px 40px 0;
  }
  .coaching-intro-img img {
    max-height: 500px;
    object-fit: cover;
    display: block;
  }
  .coaching-intro-inner {
    max-width: 600px;
  }
  .coaching-intro-inner p {
    font-size: 1.05rem;
    color: var(--color-secondary);
    line-height: 1.8;
    max-width: none;
  }

  /* ─── Aus dem Studio ─── */
  .studio-section { background: #fff; }
  .studio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }
  .studio-item img {
    width: 100%;
    max-width: 380px;
    max-height: 420px;
    object-fit: cover;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .coaching-intro-img { max-width: 320px; margin: 20px auto; }
    .formats-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .coaching-intro-grid { grid-template-columns: 1fr; }
    .coaching-intro-img { max-width: 100%; margin: 0; }
    .coaching-intro-img img { max-height: 400px; width: 100%; }
    .studio-grid { grid-template-columns: 1fr; }
  }
</style>
