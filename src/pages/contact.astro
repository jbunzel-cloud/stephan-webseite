---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt & Buchung – Stephan Schmied Hair & Make-up Artist Berlin"
  description="Buche Stephan Schmied für Hochzeit, Events, Shootings, Make-up Coaching oder Corporate. Antwort innerhalb von 24 Stunden. Berlin und deutschlandweit."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="label">Lass uns reden</span>
      <h1>Kontakt</h1>
      <p>Lass uns deinen perfekten Look planen</p>
    </div>
  </section>

  <!-- ─── Kontakt ─── -->
  <section class="section">
    <div class="container">
      <div class="contact-wrap fade-in">

        <div class="contact-card">
          <img
            src="/images/stephan-portrait.jpg"
            alt="Stephan Schmied"
            width="80" height="80"
            loading="lazy"
            class="contact-portrait"
          />
          <div>
            <p class="contact-name">Stephan Schmied</p>
            <p class="contact-job">Hair &amp; Make-up Artist</p>
            <p class="contact-addr">Berlin</p>
          </div>
        </div>

        <div class="contact-details">
          <a href="https://wa.me/491773238988" target="_blank" rel="noopener noreferrer" class="contact-detail contact-detail--link">
            <div class="contact-detail-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
              </svg>
            </div>
            <div>
              <p class="contact-detail-label">WhatsApp</p>
              <span class="contact-link">+49 177 323 8988</span>
            </div>
          </a>

          <a href="tel:+491773238988" class="contact-detail contact-detail--link">
            <div class="contact-detail-icon">☎</div>
            <div>
              <p class="contact-detail-label">Telefon</p>
              <span class="contact-link">+49 177 323 8988</span>
            </div>
          </a>

          <a href="mailto:stephan@stephanschmied.com" class="contact-detail contact-detail--link">
            <div class="contact-detail-icon">@</div>
            <div>
              <p class="contact-detail-label">E-Mail</p>
              <span class="contact-link">stephan@stephanschmied.com</span>
            </div>
          </a>

          <a href="https://instagram.com/schmiedsteph" target="_blank" rel="noopener noreferrer" class="contact-detail contact-detail--link">
            <div class="contact-detail-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <circle cx="12" cy="12" r="5"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
              </svg>
            </div>
            <div>
              <p class="contact-detail-label">Instagram</p>
              <span class="contact-link">@schmiedsteph</span>
            </div>
          </a>
        </div>

        <div class="response-note">
          <span class="response-dot"></span>
          Am schnellsten per WhatsApp — ich antworte in der Regel innerhalb von 24 Stunden.
        </div>

        <p class="review-note">
          Wir haben schon zusammengearbeitet?
          <a href="https://g.page/r/CTLsEiY00BqBEAE/review" target="_blank" rel="noopener noreferrer">Ich freue mich über deine Bewertung auf Google.</a>
        </p>

      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-wrap {
    max-width: 540px;
    margin: 0 auto;
  }
  .contact-card {
    border: 1px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    background: #fafaf8;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .contact-portrait {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    flex-shrink: 0;
  }
  .contact-name {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    margin-bottom: 0.15rem;
    max-width: none;
  }
  .contact-job {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
    max-width: none;
  }
  .contact-addr {
    font-size: 0.88rem;
    color: var(--color-secondary);
    max-width: none;
  }
  .contact-details { display: flex; flex-direction: column; gap: 0; }
  .contact-detail {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .contact-detail--link {
    text-decoration: none;
    transition: color var(--transition);
  }
  .contact-detail--link:hover .contact-link { color: var(--color-gold); }
  .contact-detail-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    font-size: 0.85rem;
    color: var(--color-secondary);
    flex-shrink: 0;
  }
  .contact-detail-label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 0.15rem;
    max-width: none;
  }
  .contact-link {
    font-size: 0.95rem;
    color: var(--color-text);
    transition: color var(--transition);
  }
  .review-note {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--color-secondary);
    max-width: none;
  }
  .review-note a {
    color: var(--color-gold-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .response-note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-secondary);
    margin-top: 1.5rem;
  }
  .response-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: #22c55e;
    border-radius: 50%;
    flex-shrink: 0;
    animation: pulse 2s ease infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }
</style>
